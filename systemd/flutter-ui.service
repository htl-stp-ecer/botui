[Unit]
Description=Flutter UI with flutter-pi
After=network.target

[Service]
ExecStart=flutter-pi -r 0 --videomode 800x480 --release /home/pi/stp-velox/
WorkingDirectory=/home/pi
User=pi
Group=pi
Restart=always
# Keep this short: the FrameStallWatchdog self-exits on a wedged render
# pipeline, and this is how fast the UI comes back after that.
RestartSec=2
# Send flutter-pi stdout/stderr to the journal so `journalctl -u flutter-ui`
# captures the Dart `print()` log output (transport, screen renderer, etc.).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
